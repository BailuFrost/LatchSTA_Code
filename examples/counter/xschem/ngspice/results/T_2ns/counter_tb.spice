SKY130 HD counter transistor transient: T=2ns
* TT, 25 C, 1.8 V, 10 fF per output; native cell SPICE, no interconnect PEX.
* Clock 50-percent crossings: rising (n+0.5)*T, falling (n+1)*T.
* Inputs cross 50 percent 1 ns after the preceding rising edge.
.lib "/home/bailufrost/eda/pdk/sky130A/libs.tech/ngspice/sky130.lib.spice" tt
.include "/mnt/hgfs/LatchSTA_Code/code/examples/counter/xschem/ngspice/results/models/sky130_hd_used.spice"
.include "/mnt/hgfs/LatchSTA_Code/code/examples/counter/xschem/ngspice/results/models/counter.spice"
.temp 25
.option reltol=1e-4 abstol=1e-12 vntol=1e-6
VDD VPWR 0 1.8
VSS VGND 0 0
VCLK clk 0 PULSE(0 1.8 0.95n 100p 100p 0.9n 2n)
VRST rst_n 0 PWL(
+ 0n 0
+ 7.95n 0
+ 8.05n 1.8
+ 133.95n 1.8
+ 134.05n 0
+ 139.95n 0
+ 140.05n 1.8
+ 235.95n 1.8
+ 236.05n 0
+ 243.95n 0
+ 244.05n 1.8)
VEN en 0 PWL(
+ 0n 0
+ 5.95n 0
+ 6.05n 1.8
+ 77.95n 1.8
+ 78.05n 0
+ 93.95n 0
+ 94.05n 1.8
+ 139.95n 1.8
+ 140.05n 0
+ 147.95n 0
+ 148.05n 1.8
+ 219.95n 1.8
+ 220.05n 0
+ 221.95n 0
+ 222.05n 1.8
+ 223.95n 1.8
+ 224.05n 0
+ 225.95n 0
+ 226.05n 1.8
+ 227.95n 1.8
+ 228.05n 0
+ 229.95n 0
+ 230.05n 1.8
+ 231.95n 1.8
+ 232.05n 0
+ 233.95n 0
+ 234.05n 1.8
+ 235.95n 1.8
+ 236.05n 0
+ 243.95n 0
+ 244.05n 1.8)
XDUT clk rst_n en VPWR VGND q3 q2 q1 q0 counter
C0 q0 0 10f
C1 q1 0 10f
C2 q2 0 10f
C3 q3 0 10f
.save v(clk) v(rst_n) v(en) i(VDD) v(q0) v(q1) v(q2) v(q3) v(xdut.master[0]) v(xdut.master[1]) v(xdut.master[2]) v(xdut.master[3]) v(xdut._00_[0]) v(xdut._00_[1]) v(xdut._00_[2]) v(xdut._00_[3])
.control
set num_threads=1
set filetype=binary
tran 5p 256.9n 0 5p
write counter.raw
.endc
.end
