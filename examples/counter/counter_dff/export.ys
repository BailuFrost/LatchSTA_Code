# 在本目录运行 yosys -s export.ys，使用 Yosys 内部单元。
read_verilog counter.v
synth -top counter -noabc

# 将计数使能展开为反馈 MUX，便于后续替换保留异步清零的 DFF。
dffunmap -ce-only

clean
hierarchy -check -top counter
check -assert
select -assert-count 4 counter/t:$_DFF_PN0_
select -assert-none counter/c:* counter/t:$_* %d counter/t:$_DLATCH* counter/p:*
stat
write_verilog -noattr -noexpr counter_yosys.v
